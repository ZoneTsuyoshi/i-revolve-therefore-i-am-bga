{
    "name": "zonetsuyoshi/i-revolve-therefore-i-am-bga",
    "description": "『我廻る、故に我あり』の Board Game Arena 実装（開発用ツール。src/ には含めない）",
    "type": "project",
    "license": "proprietary",
    "require-dev": {
        "phpunit/phpunit": "12.5.39"
    },
    "autoload": {
        "psr-4": {
            "Bga\\Games\\IRevolveThereforeIAm\\": "src/modules/php/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IRevolveTests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist --testsuite unit",
        "test:all": "phpunit --configuration phpunit.xml.dist"
    },
    "scripts-descriptions": {
        "test": "単体テスト（PHPUnit。DB 不要）。通常は npm run test:unit（Docker）で実行する",
        "test:all": "全てのテストスイート（現在は単体テストのみ）"
    }
}
